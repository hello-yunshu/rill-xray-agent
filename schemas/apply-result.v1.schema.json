{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "apply-result.v1.schema.json",
  "title": "Route Apply Result",
  "description": "Structured result of a RouteExecutor apply attempt. Never carries raw config bodies or secrets; only digests and status.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "recommendationId", "status", "configurationGeneration",
    "planSha256", "sourceConfigSha256", "committedAtEpochSeconds"
  ],
  "properties": {
    "schemaVersion": {"type": "integer", "enum": [1]},
    "recommendationId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "status": {"type": "string", "enum": ["committed", "rolledBack", "rollbackUnverified", "rejected", "blocked"]},
    "blockedBy": {"type": "array", "items": {"type": "string"}},
    "configurationGeneration": {"type": "integer"},
    "nextConfigurationGeneration": {"type": "integer"},
    "planSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sourceConfigSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "committedConfigSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "resultSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "receiptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "committedAtEpochSeconds": {"type": "integer"}
  }
}
