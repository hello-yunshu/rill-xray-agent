{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "route-plan.v1.schema.json",
  "title": "Route Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "recommendationId", "createdAtEpochSeconds",
    "expiresAtEpochSeconds", "configurationGeneration", "sourceConfigSha256",
    "topologySha256", "risk", "reasonCode", "operations",
    "preconditions", "verification", "managedScopeOnly", "planSha256"
  ],
  "properties": {
    "schemaVersion": {"type": "integer", "enum": [1]},
    "recommendationId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "semanticFingerprint": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "recommendationType": {
      "type": "string",
      "enum": [
        "managed-route-intent-restore",
        "managed-rule-shadowed",
        "unreachable-rule",
        "managed-rule-added",
        "stale-topology",
        "no-recommendation"
      ]
    },
    "evidenceDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "createdAtEpochSeconds": {"type": "integer"},
    "expiresAtEpochSeconds": {"type": "integer"},
    "configurationGeneration": {"type": "integer"},
    "sourceConfigSha256": {"type": "string"},
    "topologySha256": {"type": "string"},
    "risk": {"type": "string", "enum": ["low", "medium", "high"]},
    "reasonCode": {"type": "string"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "params", "managedScope"],
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "routingRule.insert",
              "routingRule.removeManaged",
              "routingRule.replaceManaged",
              "routingRule.moveManaged"
            ]
          },
          "managedScope": {"const": true}
        },
        "oneOf": [
          {
            "properties": {
              "op": {"const": "routingRule.insert"},
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["managedRuleId", "position", "selectorType", "selectorValue", "outboundTag"],
                "properties": {
                  "managedRuleId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
                  "position": {"type": "integer", "minimum": 0},
                  "selectorType": {"type": "string", "enum": ["domain", "ip", "port", "network", "protocol", "source"]},
                  "selectorValue": {"type": ["string", "array"], "items": {"type": "string"}},
                  "outboundTag": {"type": "string"}
                }
              }
            }
          },
          {
            "properties": {
              "op": {"const": "routingRule.removeManaged"},
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["ruleIndex"],
                "properties": {
                  "ruleIndex": {"type": "integer", "minimum": 0}
                }
              }
            }
          },
          {
            "properties": {
              "op": {"const": "routingRule.replaceManaged"},
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["managedRuleId", "ruleIndex", "selectorType", "selectorValue", "outboundTag"],
                "properties": {
                  "managedRuleId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
                  "ruleIndex": {"type": "integer", "minimum": 0},
                  "selectorType": {"type": "string", "enum": ["domain", "ip", "port", "network", "protocol", "source"]},
                  "selectorValue": {"type": ["string", "array"], "items": {"type": "string"}},
                  "outboundTag": {"type": "string"}
                }
              }
            }
          },
          {
            "properties": {
              "op": {"const": "routingRule.moveManaged"},
              "params": {
                "type": "object",
                "additionalProperties": false,
                "required": ["fromIndex", "toIndex"],
                "properties": {
                  "fromIndex": {"type": "integer", "minimum": 0},
                  "toIndex": {"type": "integer", "minimum": 0}
                }
              }
            }
          }
        ]
      }
    },
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "verification": {"type": "array", "items": {"type": "string"}},
    "managedScopeOnly": {"type": "boolean"},
    "planSha256": {"type": "string"}
  }
}
