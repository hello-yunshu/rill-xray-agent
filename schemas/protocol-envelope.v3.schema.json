{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "body": {
      "type": "object"
    },
    "capability": {
      "enum": [
        "sentinel",
        "doctor",
        "route"
      ]
    },
    "method": {
      "enum": [
        "health",
        "metrics",
        "mode",
        "config",
        "register",
        "rootResult",
        "feedback",
        "inspect",
        "snapshot"
      ]
    },
    "requestId": {
      "minLength": 1,
      "type": "string"
    },
    "schemaVersion": {
      "const": 3
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "capability",
    "method",
    "body"
  ],
  "type": "object"
}
