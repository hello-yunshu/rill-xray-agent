{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "release-capabilities.v1.schema.json",
  "title": "Release Capabilities",
  "description": "Release capability manifest for Rill Xray Agent features",
  "type": "object",
  "required": ["schemaVersion", "features"],
  "properties": {
    "schemaVersion": {"type": "integer", "enum": [1]},
    "features": {
      "type": "object",
      "required": ["routeAssist", "boundedAuto"],
      "properties": {
        "routeAssist": {
          "type": "object",
          "required": ["supported", "released"],
          "properties": {
            "supported": {"type": "boolean"},
            "released": {"type": "boolean"}
          }
        },
        "boundedAuto": {
          "type": "object",
          "required": ["supported", "released"],
          "properties": {
            "supported": {"type": "boolean"},
            "released": {"type": "boolean"}
          }
        }
      }
    }
  }
}
