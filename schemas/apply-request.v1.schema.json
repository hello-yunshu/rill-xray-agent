{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "apply-request.v1.schema.json",
  "title": "Route Apply Request",
  "description": "Root-executor input. The executor re-validates the whole envelope against the CURRENT release manifest and the CURRENT managed config digest/generation; nothing in the request is trusted by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "recommendationId", "createdAtEpochSeconds",
    "expiresAtEpochSeconds", "configurationGeneration", "sourceConfigSha256",
    "planSha256", "applyType", "mode", "effectiveStage",
    "releaseSnapshot", "operations", "requestSha256"
  ],
  "properties": {
    "schemaVersion": {"type": "integer", "enum": [1]},
    "recommendationId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "createdAtEpochSeconds": {"type": "integer"},
    "expiresAtEpochSeconds": {"type": "integer"},
    "configurationGeneration": {"type": "integer", "minimum": 0},
    "sourceConfigSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "planSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "applyType": {"type": "string", "enum": ["manual", "auto"]},
    "mode": {"type": "string", "enum": ["normal", "observe-only", "safe-disabled"]},
    "effectiveStage": {"type": "string", "enum": ["observe", "assist", "auto", "disabled"]},
    "releaseSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routeAssist", "boundedAuto"],
      "properties": {
        "routeAssist": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supported", "released"],
          "properties": {
            "supported": {"type": "boolean"},
            "released": {"type": "boolean"}
          }
        },
        "boundedAuto": {
          "type": "object",
          "additionalProperties": false,
          "required": ["supported", "released"],
          "properties": {
            "supported": {"type": "boolean"},
            "released": {"type": "boolean"}
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "params", "managedScope"],
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "routingRule.insert",
              "routingRule.removeManaged",
              "routingRule.replaceManaged",
              "routingRule.moveManaged"
            ]
          },
          "params": {"type": "object", "maxProperties": 8},
          "managedScope": {"type": "boolean"}
        }
      }
    },
    "requestSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
