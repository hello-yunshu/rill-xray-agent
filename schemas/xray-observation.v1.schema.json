{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "capturedAtEpochSeconds": {
      "minimum": 1,
      "type": "integer"
    },
    "installConfig": {
      "type": "object"
    },
    "nginxConfig": {
      "type": "object"
    },
    "nginxValidation": {
      "type": "object"
    },
    "schemaVersion": {
      "const": 1
    },
    "services": {
      "type": "object"
    },
    "xrayConfig": {
      "type": "object"
    },
    "xrayValidation": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "capturedAtEpochSeconds",
    "xrayConfig",
    "nginxConfig",
    "installConfig",
    "xrayValidation",
    "nginxValidation",
    "services"
  ],
  "type": "object"
}
